# API Base URL. When this stays on localhost, the browser automatically swaps
# localhost for the page's LAN host when opened from a phone.
# Development (local backend)
VITE_API_BASE_URL=http://localhost:8000

# LAN access (replace with your machine's IP)
# VITE_API_BASE_URL=http://192.168.1.100:8000
```

